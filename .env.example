# Copia questo file in ".env" e adatta i valori. Non committare mai ".env".

# --- Sviluppo locale ---------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=sviluppo-solo-locale-cambiami
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Per provare dal telefono sulla stessa rete Wi-Fi aggiungi l'IP del PC, es.:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20

# --- Produzione (DJANGO_DEBUG=0) ---------------------------------------------
# Genera la chiave con (solo caratteri sicuri per un file .env):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=...
# DJANGO_ALLOWED_HOSTS=gestionale.tuodominio.it
# DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionale.tuodominio.it
# DJANGO_BEHIND_PROXY=1          # se c'è nginx/Caddy davanti che passa X-Forwarded-Proto
# DJANGO_SSL_REDIRECT=0          # solo se il redirect a HTTPS lo fa già la piattaforma e si va in loop
# DJANGO_HSTS_SECONDS=31536000   # attivalo solo dopo aver verificato che HTTPS funziona
# DJANGO_ADMIN_URL=pannello-xyz/ # sposta l'admin su un indirizzo non ovvio

# --- Opzionali ---------------------------------------------------------------
# Default: SQLite nel file db.sqlite3. Per PostgreSQL:
# DATABASE_URL=postgres://utente:password@localhost:5432/pacchiperduti
# Cartella delle foto (default: ./media). Includila nei backup.
# MEDIA_ROOT=/var/data/pacchiperduti/media
# Dimensione massima della foto caricata, in MB (default 15)
# MAX_UPLOAD_MB=15
# Blocco dei login: dopo N password sbagliate l'utente resta bloccato per M minuti
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=15
